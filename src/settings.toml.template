# deloop device settings
# Copy to src/settings.toml and fill in your values.
# settings.toml is deployed to /CIRCUITPY/ and read by CircuitPython at boot.
# All values are read as strings via os.getenv(); config.py converts types.

# WiFi credentials (required)
WIFI_SSID = "your_wifi_ssid"
WIFI_PASS = "your_wifi_password"

# Which device backend to use: "denon" (default), "minidsp", "ha", "wiim",
# or "camilladsp". See README.md "Device backends" for what each one supports.
# DEVICE_DRIVER = "denon"

# --- Denon/Marantz AVR (required if DEVICE_DRIVER = "denon") ---
AVR_HOST = "192.168.1.100"
# AVR_PORT          = "8080"

# --- minidsp-rs daemon (required if DEVICE_DRIVER = "minidsp") ---
# Host running minidsp-rs with the MiniDSP attached over USB -- NOT the
# DSP's own address. Running it with no --config at all already binds the
# HTTP API to 0.0.0.0:5380 (all interfaces) by default, so it may already
# be reachable over the LAN with zero extra setup. If you do use a config
# file, make sure its [http_server] bind_address isn't left at the
# restrictive "127.0.0.1:5380" the docs' example ships with -- that's
# localhost-only. A config file only takes effect if you pass it explicitly
# via `--config /path/to/file.toml` on the daemon's command line; there's no
# default path it looks for.
# MINIDSP_HOST          = "192.168.1.101"
# MINIDSP_PORT          = "5380"
# MINIDSP_DEVICE_INDEX  = "0"
# MINIDSP_PRESET_COUNT  = "4"    # set to your unit's actual config slot count
# Human-readable names for config slots 0..N-1, comma-separated and in
# order. Any slot left unnamed (including all of them, if this is unset)
# falls back to "Preset 1", "Preset 2", etc.
# MINIDSP_PRESET_NAMES  = "Movie,Music,Night,Flat"
# Switching config slots/presets is a full DSP reconfiguration -- minidsp-rs's
# POST doesn't return until it's actually applied, measured ~4s on a real
# Flex. Raise this if yours is slower; too short and the request silently
# times out client-side before the display ever updates (and an abandoned
# in-flight request seems able to crash minidsp-rs itself).
# MINIDSP_PRESET_TIMEOUT = "10000"
# Only needed if more than one MiniDSP unit is ever attached to that host at
# once: /devices' array order depends on USB enumeration order, which isn't
# stable across reconnects/reboots. Setting this pins to a specific unit by
# serial number instead of index -- see "version.serial" in `make probe-minidsp`.
# MINIDSP_SERIAL        = ""

# --- Home Assistant media_player entity (required if DEVICE_DRIVER = "ha") ---
# Any entity in the media_player domain -- volume/mute/power/source only;
# no preset/filter support (see README.md "Device backends").
# HA_HOST      = "192.168.1.102"
# HA_PORT      = "8123"
# HA_TOKEN     = "your_long_lived_access_token"
# HA_ENTITY_ID = "media_player.office"
# Play/pause status text + tap-to-toggle -- off by default. This is a rougher
# fit than volume/mute/power/source: whether it actually does anything
# depends on the currently selected source (e.g. no-op on a plain analog
# input), so it's opt-in rather than on by default.
# HA_MEDIA_CONTROLS = "true"

# --- WiiM / LinkPlay streamer (required if DEVICE_DRIVER = "wiim") ---
# The streamer's own IP -- deloop talks straight to it, no bridge/daemon and
# no token or auth of any kind (unlike Home Assistant). Its API is HTTPS-only
# with a self-signed certificate, which deloop already knows about and trusts
# (LinkPlay ships the same cert on every unit) -- nothing to configure.
# WIIM_HOST = "192.168.1.103"
# Sources to offer in the Source menu, comma-separated, in menu order. The
# default below was confirmed working on a WiiM Pro; other WiiM/LinkPlay
# models expose a different physical set and there's no API that reports
# which, so adjust to match your unit. Recognized keys: wifi, bluetooth,
# line-in, optical, co-axial, udisk, hdmi, phono, pcusb.
# WIIM_INPUTS = "wifi,bluetooth,line-in,optical"
# WIIM_TIMEOUT = "2000"
# WiiM-app Favorites can't be listed back reliably over the plain HTTP API
# (confirmed live: getPresetInfo stays empty even with real Favorites
# configured) -- set how many you've actually set up (1-12) to show a Preset
# menu at all, and optionally name them, comma-separated in order. Any slot
# left unnamed falls back to "Preset N". See src/wiim.py's module docstring.
# WIIM_PRESET_COUNT = "2"
# WIIM_PRESET_NAMES = "Morning Radio,Jazz Station"

# --- CamillaDSP (required if DEVICE_DRIVER = "camilladsp") ---
# Confirmed working end to end on real M5 Dial hardware (2026-07-30) -- run
# `make probe-camilladsp` first regardless, to confirm your own instance
# behaves as expected before flashing.
# Host running CamillaDSP -- NOT anything about the audio devices it's
# processing, just where its own websocket control server is reachable.
# Same "must already be running, must be LAN-reachable" topology as minidsp,
# except CamillaDSP's control API is websocket-only, no HTTP option -- see
# src/camilladsp.py.
# CAMILLADSP_HOST = "192.168.1.104"
# CAMILLADSP_PORT = "1234"   # whatever port CamillaDSP was started with -p
# CAMILLADSP_TIMEOUT = "2000"
# Presets -- CamillaDSP config files to offer, as "Name:/path/to/config.yml"
# pairs, comma-separated, in menu order. Path must be absolute and resolvable
# by the CamillaDSP process itself (not this device). Leave unset for no
# Preset menu at all. Reachable through the scrollable Preset menu regardless
# of size -- CAMILLADSP_QUICK_PRESETS below is a separate, smaller list for
# main-screen buttons.
# CAMILLADSP_PRESETS = "Movie:/home/user/configs/movie.yml,Music:/home/user/configs/music.yml"
# Up to 4 names from CAMILLADSP_PRESETS (must match exactly) to also show as
# main-screen quick-select buttons, comma-separated. Leave unset for no quick
# buttons at all (submenu-only). Unlike minidsp/denon, CAMILLADSP_PRESETS
# itself has no size limit, so this is a deliberately separate, capped list
# rather than "show buttons for everything" -- see src/camilladsp.py.
# CAMILLADSP_QUICK_PRESETS = "Movie,Music"
# Switching presets triggers a full filter-pipeline reload -- raise this if
# your config is slow to reload. Measured ~1-3ms against a trivial test
# config (no FIR/convolution files to load) -- a real production config
# could be much slower; not yet measured for that case.
# CAMILLADSP_PRESET_TIMEOUT = "10000"

# --- Self-update (optional) ---
# Pulls new deloop app-file releases from a flat S3 layout -- NOT
# CircuitPython firmware. Manual only: opens via the "Update" menu, nothing
# runs in the background. See README.md "Updating deloop" and docs/ota.md.
# OTA_ENABLED = "true"
# OTA_S3_BASE = "https://deloop.s3.us-east-1.amazonaws.com"
# OTA_REPO = "anotherhobby/deloop"  # CI-side GitHub Release only (changelog/history) -- device never reads this
# OTA_CHECK_TIMEOUT = "10000"
# OTA_INSTALL_TIMEOUT = "60000"

# Optional overrides (safe to leave commented out)
# VOLUME_MIN        = "-80.0"  # per-driver default set in config.py (dB, or 0-100
# VOLUME_MAX        = "18.0"   # percent for DEVICE_DRIVER = "ha" / "wiim")
# VOLUME_STEP       = "0.5"    # per tick at normal speed (dB or percent)
# VOLUME_STEP_FAST  = "2.0"    # per tick when spinning fast (dB or percent)
# ACCEL_THRESHOLD   = "100"     # ms between ticks that triggers fast mode
# ACCEL_SAFETY_CAP  = "-15.0"  # max volume (dB) allowed during fast upward spin
# POLL_INTERVAL     = "30.0"
# STANDBY_BRIGHTNESS_FRAC = "0.25"  # standby/off brightness, as a fraction (0.0-1.0) of your own
# MUTE_PULSE        = "false"  # mute "breathing" animation -- on by default, set false to disable
